# NEON ORB — entorno seguro del bridge. NO subir secretos reales al repositorio.
NEON_SOLANA_RPC=https://api.mainnet-beta.solana.com
NEON_SOLANA_KEYPAIR_PATH=keypair.json
NEON_SOLANA_PUBLIC_KEY=AvcMD59dTTTnHKzfdQtF9AcSzgSNcqCWEkcUYx4BnUeh
NEON_SOLANA_BRIDGE_PORT=8788
NEON_AGENT_LOOP_INTERVAL=300
# Opcional: ruta para el último estado computable recibido.
# NEON_ORB_STATE_FILE=/ruta/segura/neon-orb-state.json

# V10 — Treasury de la misma cuenta Solana de Neon Orb. No se hace una transferencia a sí misma;
# el bridge calcula y registra una RESERVA LÓGICA/CONTABLE verificada sobre el saldo real.
NEON_TREASURY_DESTINATION=AvcMD59dTTTnHKzfdQtF9AcSzgSNcqCWEkcUYx4BnUeh
# 10000 = 100% del saldo disponible sobre el mínimo de retención.
NEON_TREASURY_SHARE_BPS=2000
NEON_TREASURY_MIN_RETAIN_LAMPORTS=0

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
NEON_ADMIN_TOKEN=
NEON_MAX_SINGLE_SETTLEMENT_EUR=1000
NEON_MAX_DAILY_VERIFIED_REVENUE_EUR=10000
