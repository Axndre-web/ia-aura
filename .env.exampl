# NEON ORB — entorno seguro del bridge. NO subir secretos reales al repositorio.
NEON_SOLANA_RPC=https://api.mainnet-beta.solana.com
NEON_SOLANA_KEYPAIR_PATH=keypair.json
NEON_SOLANA_PUBLIC_KEY=AvcMD59dTTTnHKzfdQtF9AcSzgSNcqCWEkcUYx4BnUeh
NEON_SOLANA_BRIDGE_PORT=8788
NEON_AGENT_LOOP_INTERVAL=300
# Opcional: ruta para el último estado computable recibido.
# NEON_ORB_STATE_FILE=/ruta/segura/neon-orb-state.json

# V10 — Treasury de la misma cuenta Solana de Neon Orb. No se hace una transferencia a sí misma;
# el bridge calcula y registra una RESERVA LÓGICA/CONTABLE verificada sobre el saldo real.
NEON_TREASURY_DESTINATION=AvcMD59dTTTnHKzfdQtF9AcSzgSNcqCWEkcUYx4BnUeh
# 10000 = 100% del saldo disponible sobre el mínimo de retención.
NEON_TREASURY_SHARE_BPS=2000
NEON_TREASURY_MIN_RETAIN_LAMPORTS=0

# V11.8 — External economic capability endpoints. HTTPS + host allowlist required.
# Add only the providers you actually contract/connect; never place secrets in this file.
# NEON_ALLOWED_PROVIDER_HOSTS=api.provider.example,reporting.provider.example
# NEON_ECONOMIC_PROGRAMMATIC_ADS_URL=https://api.provider.example/economic/ads
# NEON_ECONOMIC_DECENTRALIZED_STORAGE_URL=https://api.provider.example/economic/storage
# NEON_ECONOMIC_WEB3_MICROPAYMENTS_URL=https://api.provider.example/economic/web3
# NEON_ECONOMIC_FINANCIAL_ORACLES_URL=https://api.provider.example/economic/oracle
# NEON_ECONOMIC_CDN_EDGE_URL=https://api.provider.example/economic/cdn
# NEON_ECONOMIC_VALIDATOR_REWARDS_URL=https://api.provider.example/economic/validators
# NEON_ECONOMIC_TRANSCODING_STREAMING_URL=https://api.provider.example/economic/media
# NEON_ECONOMIC_AFFILIATE_REFERRALS_URL=https://api.provider.example/economic/affiliate
# NEON_ECONOMIC_DECENTRALIZED_IDENTITY_URL=https://api.provider.example/economic/identity
# NEON_ECONOMIC_TELEMETRY_ANALYTICS_URL=https://api.provider.example/economic/telemetry
